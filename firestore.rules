rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins are created ONLY manually in the Firebase console. Nobody can write from the app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Students: read only. Admins: full control.
    match /courses/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notices/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /tasks/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }

    // Students: may add a text comment as themselves. Admins: may delete.
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
